---
// Estilo "Pasos numerados": el valor es el paso y la etiqueta, su explicación (opcional).
import type { ItemsProps as Props } from './types';

const { items } = Astro.props;
---

<ol class="mt-6 flex max-w-md flex-col gap-4 text-left">
  {
    items.map((it, n) => (
      <li class="flex items-start gap-4 text-left">
        <span class="font-display text-2xl text-teja shrink-0 leading-none mt-1">{n + 1}</span>
        <div class="text-left">
          <h3 class="text-lg leading-snug">{it.valor}</h3>
          {it.etiqueta && <p class="mt-1 text-sm text-crema/70 leading-normal">{it.etiqueta}</p>}
        </div>
      </li>
    ))
  }
</ol>
