---
import './styles/Dishes.css';
import Icon from './Icon.astro';
import Media from './Media.astro';
import { dishesView } from './Dishes.view';
import type { Props } from './Dishes.types';

const { bloque, site } = Astro.props;
const { items, isShop, pedirLink, notaHtml } = dishesView(bloque, site);
---

<section id="productos" data-spy="#productos" aria-labelledby="productos-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p data-reveal class="text-sm text-teja">{bloque.eyebrow}</p>
        <h2 id="productos-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo}</h2>
      </div>
      <div class="flex items-center gap-3 self-start md:self-auto">
        <button
          type="button"
          data-cart-open
          class="btn btn-outline btn-sm inline-flex items-center gap-2"
        >
          <Icon name="shoppingBag" class="size-4" />
          <span>Ver Carrito</span>
        </button>
        <a
          data-reveal
          style="--d:200ms"
          href={pedirLink}
          class="link inline-flex items-center gap-2 text-sm"
          rel="noopener"
          target="_blank"
        >
          WhatsApp directo
          <Icon name="arrowUpRight" />
        </a>
      </div>
    </div>

    {
      isShop ? (
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((producto, i) => (
            <article
              data-reveal
              style={`--d:${i * 60}ms`}
              class="shop-card group flex flex-col justify-between overflow-hidden rounded-[24px] border border-[#ebebeb] bg-white p-4 shadow-[0_2px_8px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_28px_rgba(0,0,0,0.08)]"
            >
              <div>
                {producto.foto.src ? (
                  <div class="relative aspect-4/3 w-full overflow-hidden rounded-[18px] bg-[#f2f4f5]">
                    <Media
                      img={{ src: producto.foto.src, alt: producto.foto.alt || producto.nombre }}
                      widths={[320, 640]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      pictureClass="size-full"
                      class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                    />
                    {producto.agotado && (
                      <span class="absolute left-3 top-3 inline-flex rounded-full bg-black/75 px-3 py-1 text-xs font-semibold text-white backdrop-blur-xs">
                        Agotado
                      </span>
                    )}
                  </div>
                ) : (
                  <div class="flex aspect-4/3 w-full items-center justify-center rounded-[18px] bg-[#f2f4f5] text-xs text-muted-gray">
                    Sin imagen
                  </div>
                )}

                <div class="mt-4 px-1">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-sans text-lg font-bold tracking-tight text-black">{producto.nombre}</h3>
                    <span class="shrink-0 font-sans text-base font-bold text-teja tabular-nums">{producto.precio}</span>
                  </div>
                  {producto.detalle && (
                    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted-gray">{producto.detalle}</p>
                  )}
                </div>
              </div>

              <div class="mt-5 px-1">
                {producto.agotado ? (
                  <button
                    type="button"
                    disabled
                    class="w-full cursor-not-allowed rounded-full bg-[#f2f4f5] py-2.5 text-center text-xs font-semibold text-cool-stone"
                  >
                    Agotado
                  </button>
                ) : (
                  <button
                    type="button"
                    data-cart-add
                    data-product-id={producto.id}
                    data-product-name={producto.nombre}
                    data-product-price={producto.precio}
                    data-product-unit-price={producto.unitPrice}
                    data-product-image={producto.foto.src}
                    class="btn-shop-add flex w-full items-center justify-center gap-2 rounded-full border border-faint-border bg-white py-2.5 text-xs font-bold text-black shadow-xs transition-all hover:border-teja hover:bg-teja hover:text-on-teja hover:shadow-md active:scale-98"
                  >
                    <Icon name="plus" class="size-3.5" />
                    <span data-cart-btn-label>Añadir al carrito</span>
                  </button>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <ol class="mt-12 divide-y divide-crema/10">
          {items.map((producto, i) => (
            <li
              data-reveal
              style={`--d:${i * 80}ms`}
              class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 py-6 md:grid-cols-[auto_1fr_auto_auto_auto] md:items-center lg:py-8"
            >
              <span class="font-display text-sm text-teja tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <div class:list={[producto.agotado && 'opacity-60']}>
                <h3 class="text-2xl lg:text-4xl">{producto.nombre}</h3>
                {producto.detalle && <p class="mt-2 text-base text-crema/70">{producto.detalle}</p>}
              </div>
              {producto.agotado ? (
                <p class="col-start-2 mt-2 md:col-start-3 md:mt-0">
                  <span class="inline-flex rounded-(--radius-btn) px-3 py-1 text-sm ring-1 ring-crema/30">Agotado</span>
                </p>
              ) : (
                <p class="col-start-2 mt-2 font-display text-2xl md:col-start-3 md:mt-0 lg:text-3xl">{producto.precio}</p>
              )}
              {producto.foto.src && (
                <Media
                  img={{ src: producto.foto.src, alt: producto.foto.alt || producto.nombre }}
                  widths={[160, 320]}
                  sizes="96px"
                  pictureClass="col-start-2 mt-4 block h-24 w-20 md:col-start-4 md:mt-0"
                  class="size-full mask-oval object-cover"
                />
              )}
              {!producto.agotado && (
                <div class="col-start-2 mt-3 md:col-start-5 md:mt-0">
                  <button
                    type="button"
                    data-cart-add
                    data-product-id={producto.id}
                    data-product-name={producto.nombre}
                    data-product-price={producto.precio}
                    data-product-unit-price={producto.unitPrice}
                    data-product-image={producto.foto.src}
                    aria-label={`Añadir ${producto.nombre} al pedido`}
                    class="btn btn-outline btn-sm inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold"
                  >
                    <Icon name="plus" class="size-3" />
                    <span data-cart-btn-label>Añadir</span>
                  </button>
                </div>
              )}
            </li>
          ))}
        </ol>
      )
    }

    {notaHtml && <p data-reveal class="mt-8 max-w-2xl text-sm text-crema/70" set:html={notaHtml} />}
  </div>
</section>
